BACKBOARD_API_KEY=
# Teacher (labels + escalations): provider/model, as accepted by Backboard
TEACHER_MODEL=openai/gpt-6-luna
# USD per 1M tokens (OpenAI pricing page: $0.10 in / $0.50 out)
TEACHER_PRICE_IN_PER_M=0.10
TEACHER_PRICE_OUT_PER_M=0.50
# Ticket generator (ai.google.dev pricing: $0.30 in / $2.50 out)
GENERATOR_MODEL=google/gemini-2.5-flash
GENERATOR_PRICE_IN_PER_M=0.30
GENERATOR_PRICE_OUT_PER_M=2.50
AWS_PROFILE=default
LOCAL_MODEL=mlx-community/gemma-4-e4b-it-4bit
DB_PATH=understudy.sqlite

# --- Nebius Token Factory fine-tuning (training/nebius.py; docs/nebius.md) ---
# Key from https://tokenfactory.nebius.com/project/api-keys. Never commit the real value.
NEBIUS_API_KEY=
# OpenAI-compatible base URL (includes /v1)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Base model to fine-tune. google/gemma-4-E4B-it is on Nebius's list but FULL fine-tune only (no LoRA)
NEBIUS_FT_MODEL=google/gemma-4-E4B-it
# true => LoRA (needs a LoRA-capable base, e.g. Qwen/Qwen3-4B), false => full fine-tune (Gemma 4)
NEBIUS_FT_LORA=false
# Hyperparameters (Nebius ranges: epochs 1-20, batch 1-64, lora_r 8-128, context >= 8192)
NEBIUS_FT_EPOCHS=3
NEBIUS_FT_BATCH_SIZE=8
NEBIUS_FT_LR=1e-5
NEBIUS_FT_LORA_R=16
NEBIUS_FT_LORA_ALPHA=32
NEBIUS_FT_LORA_DROPOUT=0.0
NEBIUS_FT_CONTEXT=8192
NEBIUS_FT_PACKING=true
NEBIUS_FT_SEED=42
NEBIUS_FT_SUFFIX=understudy
# Optional: continue from an HF repo (from_checkpoint.type=hf; sends HF_TOKEN to Nebius). Leave empty normally
NEBIUS_FT_FROM_HF_REPO=
# HF token: tokenizer download for NEBIUS_DATA_FORMAT=pretokenized (Gemma is gated)
HF_TOKEN=
# messages = Nebius applies the chat template (loss masking undocumented); pretokenized = we mask the prompt
NEBIUS_DATA_FORMAT=messages
# 1 = download the last checkpoint into adapters/round_N (full Gemma 4 weights are ~16 GB); 0 = keep remote only
NEBIUS_DOWNLOAD=1
# USD per 1M trained tokens (not published in the docs; copy from your console price list). Empty => cost 0.0 + note
NEBIUS_PRICE_PER_M_TOKENS=
# Poll interval seconds (Nebius asks >= 15; backs off to 60) and hard timeout after which the job is CANCELLED
NEBIUS_POLL_S=15
NEBIUS_MAX_WAIT_MIN=180
