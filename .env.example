BACKBOARD_API_KEY=
# Teacher (labels + escalations): provider/model, as accepted by Backboard
TEACHER_MODEL=openai/gpt-6-luna
# USD per 1M tokens (OpenAI pricing page: $0.10 in / $0.50 out)
TEACHER_PRICE_IN_PER_M=0.10
TEACHER_PRICE_OUT_PER_M=0.50
# Ticket generator (ai.google.dev pricing: $0.30 in / $2.50 out)
GENERATOR_MODEL=google/gemini-2.5-flash
GENERATOR_PRICE_IN_PER_M=0.30
GENERATOR_PRICE_OUT_PER_M=2.50
AWS_PROFILE=default
LOCAL_MODEL=mlx-community/gemma-4-e4b-it-4bit
DB_PATH=understudy.sqlite
