# Backend (FastAPI). Locally this is the Mac's loopback; on Vercel it is the cloudflared tunnel URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# "api" (default): use the live backend, falling back to the newest saved snapshot when it is unreachable.
# "snapshot": never call the API; show the bundled public/export/snapshot.json (public Vercel deploy without a tunnel).
NEXT_PUBLIC_DATA_SOURCE=api
